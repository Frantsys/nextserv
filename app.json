{
  "expo": {
    "name": "NextServ",
    "slug": "NextServ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nextserv/icon.png",
    "scheme": "nextserv",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O aplicativo precisa da sua localização para encontrar profissionais próximos."
      }
    },
    "splash": {
      "image": "./assets/nextserv/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/nextserv/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/nextserv/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luciosantosdev.NextServ",
      "config": {
        "googleMaps": {
          "apiKey": "SUA_API_KEY_DO_GOOGLE_MAPS_AQUI"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/nextserv/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",

      [
        "expo-location",
        {
          "locationForegroundPermission": "O aplicativo precisa da sua localização para encontrar profissionais próximos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
